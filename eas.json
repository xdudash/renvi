{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development"
    },
    "development-simulator": {
      "extends": "development",
      "ios": { "simulator": true }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "android": { "buildType": "apk" }
    },
    "production": {
      "environment": "production",
      "distribution": "store",
      "autoIncrement": true,
      "channel": "production",
      "ios": { "resourceClass": "default" }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
